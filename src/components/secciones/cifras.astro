---
// Cifras: banda esmeralda a todo el ancho; titular arriba a la izquierda y las cifras enormes en serifa
// marino, en 2 columnas en móvil y hasta 4 en escritorio, separadas por filetes. Sin cifras no se pinta.
// `items`: titulo (la cifra, como texto) y texto (la etiqueta).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.slice(0, 8) : [];
---

{
  s && items.length > 0 && (
    <Seccion id={Astro.props.id} banda="esmeralda">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} resalte={s.resalte} texto={s.texto} class="!mb-10 md:!mb-14" />
      <ul class:list={['grid grid-cols-2 border-t-2 border-current', items.length >= 4 ? 'lg:grid-cols-4' : items.length === 3 ? 'lg:grid-cols-3' : '']}>
        {items.map((it) => (
          <li class="cifra pt-6 pr-4 md:pt-8">
            <p class="font-display text-[clamp(2.8rem,7vw,5.5rem)] font-bold leading-none tracking-tight">{it.titulo}</p>
            {it.texto && <p class="mt-3 text-sm font-bold uppercase tracking-[.14em] md:text-base">{it.texto}</p>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}

<style>
  .cifra { padding-bottom: 1.5rem; }
  .cifra:nth-child(2n) { padding-left: 1rem; border-left: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
  @media (min-width: 1024px) {
    .cifra { padding-left: 1.75rem; border-left: 1px solid color-mix(in srgb, currentColor 30%, transparent); }
    .cifra:first-child { padding-left: 0; border-left: 0; }
  }
</style>
