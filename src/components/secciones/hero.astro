---
// Portada partida a sangre: mitad marino con antetítulo, título enorme en serifa (con `resalte`), texto y dos
// botones; mitad con la foto hasta el borde derecho de la ventana y la «esquina de póliza» abajo a la
// izquierda, con un sello esmeralda (`nota`). Debajo, la barra de confianza a todo el ancho en esmeralda:
// `items` (titulo + icono, hasta cuatro). Sin foto, el texto ocupa todo el ancho; sin items, no hay barra.
import { seccion } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
import Resalte from '../ui/Resalte.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const confianza = s ? s.items.slice(0, 4) : [];
const nota = String(s?.nota ?? '').trim();
---

{
  s && (
    <section id={id} class="hero">
      <div class:list={['banda banda--marino grid', s.imagen && 'lg:grid-cols-2']}>
        <svg class="escudo-agua -left-24 -top-16 h-[34rem] w-[30rem] md:h-[46rem] md:w-[40rem]" viewBox="0 0 26 29" aria-hidden="true"><path d="M13 1l11 4v8c0 7-4.7 12.6-11 15C6.7 25.6 2 20 2 13V5z" fill="currentColor" /></svg>
        <div class:list={['hero-texto flex min-w-0 flex-col justify-center py-16 md:py-24', s.imagen ? 'alinea-izq pr-4 md:pr-12' : 'contenedor']}>
          <div class:list={[s.imagen ? 'max-w-[42rem]' : 'max-w-[64rem]']}>
            {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
            <h1 class:list={['mt-6 font-bold leading-[1.02]', s.imagen ? 'text-[clamp(2.6rem,6.2vw,6.5rem)]' : 'text-[clamp(2.8rem,7.5vw,7rem)]']}>
              <Resalte texto={s.titulo} resalte={s.resalte} />
            </h1>
            {s.texto && <p class="mt-7 max-w-xl text-lg leading-relaxed opacity-85 md:text-xl">{s.texto}</p>}
            {(s.cta || s.cta_secundario) && (
              <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
                {s.cta_secundario && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
              </div>
            )}
          </div>
        </div>
        {s.imagen && (
          <div class="relative min-h-[20rem] sm:min-h-[28rem] lg:min-h-0">
            <Imagen src={s.imagen} alt={altHero()} ancho={1600} alto={1200} prioridad={primera} class="foto-esquina absolute inset-0 h-full w-full object-cover" />
            {nota && (
              <p class="sello absolute bottom-5 left-5 flex max-w-[16rem] items-center gap-3 rounded-full py-2 pl-2 pr-5 text-sm font-bold leading-tight md:bottom-10 md:left-auto md:right-10">
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[var(--c-oscuro)] text-acento" aria-hidden="true"><Icono nombre="escudo" tam={22} /></span>
                {nota}
              </p>
            )}
          </div>
        )}
      </div>
      {confianza.length > 0 && (
        <div class="banda banda--esmeralda">
          <ul class:list={['contenedor grid grid-cols-2', confianza.length >= 4 ? 'lg:grid-cols-4' : confianza.length === 3 ? 'lg:grid-cols-3' : '']} aria-label="Por qué confiar en nosotros">
            {confianza.map((it) => (
              <li class="confianza flex items-center gap-3 py-5 md:gap-4 md:py-7">
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border-2 border-current md:h-12 md:w-12" aria-hidden="true"><Icono nombre={it.icono || 'check'} tam={20} /></span>
                <span class="text-sm font-bold leading-snug md:text-lg">{it.titulo}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  )
}

<style>
  .hero > .banda:first-child { min-height: calc(85svh - var(--alto-cabecera)); }
  @media (min-width: 1024px) { .hero > .banda:first-child { min-height: calc(88svh - var(--alto-cabecera) - 2.25rem); } }
  .alinea-izq { padding-left: 1rem; }
  @media (min-width: 768px) { .alinea-izq { padding-left: 2rem; } }
  @media (min-width: 1024px) { .alinea-izq { padding-left: max(2rem, calc((100vw - var(--ancho)) / 2 + 2rem)); } }
  .sello { background: var(--c-fondo); color: var(--c-primario); box-shadow: 0 20px 40px -20px rgb(0 0 0 / .5); }
  .confianza { padding-inline: .75rem; border-left: 1px solid color-mix(in srgb, currentColor 22%, transparent); }
  .confianza:nth-child(2n + 1) { border-left: 0; padding-left: 0; }
  @media (min-width: 1024px) {
    .confianza { padding-inline: 1.5rem; }
    .confianza:nth-child(2n + 1) { border-left: 1px solid color-mix(in srgb, currentColor 22%, transparent); padding-left: 1.5rem; }
    .confianza:first-child { border-left: 0; padding-left: 0; }
  }
</style>
