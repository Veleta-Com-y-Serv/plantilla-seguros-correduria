---
// Ejemplo de página adicional: usa el layout base y se enlaza desde el pie (o desde site.yaml → menu).
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const c = site.contacto;
---

<Base titulo="Aviso legal y privacidad" descripcion={`Aviso legal y política de privacidad de ${site.nombre}.`}>
  <section class="banda banda--marino">
    <svg class="escudo-agua -right-24 -top-24 h-[34rem] w-[30rem]" viewBox="0 0 26 29" aria-hidden="true"><path d="M13 1l11 4v8c0 7-4.7 12.6-11 15C6.7 25.6 2 20 2 13V5z" fill="currentColor"></path></svg>
    <div class="contenedor py-16 md:py-24">
      <p class="antetitulo">{site.nombre}</p>
      <h1 class="mt-6 text-[clamp(2.6rem,7vw,5.5rem)] font-bold leading-[.98]">Aviso legal y <em class="resalte">privacidad</em></h1>
    </div>
  </section>
  <div class="banda banda--esmeralda h-3" aria-hidden="true"></div>
  <section class="banda banda--blanca">
    <article class="contenedor max-w-3xl py-16 md:py-24 texto-largo">
      <h2>Quiénes somos</h2>
      <p>
        Esta web pertenece a {site.nombre}{c.direccion && `, con domicilio en ${c.direccion}`}. Puedes escribirnos a {
          c.email || 'nuestro correo de contacto'
        }{c.telefono && ` o llamarnos al ${c.telefono}`}.
      </p>
      <h2>Qué datos tratamos</h2>
      <p>
        Solo los que nos envías al escribirnos o al pedir una comparativa: nombre, forma de contacto, qué quieres
        asegurar y tu mensaje. Los usamos para responderte y preparar la comparativa. No los cedemos a nadie salvo
        obligación legal o que nos pidas presentar tu solicitud a una aseguradora.
      </p>
      <h2>Cuánto tiempo los guardamos</h2>
      <p>El necesario para atender tu consulta y, después, el que marque la ley.</p>
      <h2>Tus derechos</h2>
      <p>
        Puedes pedir acceso, rectificación o supresión de tus datos escribiendo a {c.email || 'nuestro correo'}. También
        puedes reclamar ante la Agencia Española de Protección de Datos (aepd.es).
      </p>
      <h2>Cookies</h2>
      <p>Esta web no usa cookies de seguimiento.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </article>
  </section>
</Base>
