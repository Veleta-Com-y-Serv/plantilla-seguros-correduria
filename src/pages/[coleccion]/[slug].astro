---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /seguros/<slug>/.
// Diseño «póliza»: banda marino con migas y hero partido (título en serifa con resalte esmeralda, texto, precio y
// botones; a la derecha la foto con la esquina curva o, sin foto, el icono en círculo esmeralda), banda blanca con el
// `detalle` y, al lado, la tabla de datos en niebla y la caja marino de comparativa; galería en banda niebla y
// otros seguros en banda niebla con tarjetas de filete esmeralda.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoCita = site.boton_cabecera?.texto || 'Pide tu comparativa';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre el seguro de ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda--marino ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="ficha-hero">
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion"><em class="resalte">{f.titulo}</em></h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-chips"><span class="ficha-precio">{f.precio}</span></p>}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto foto-esquina">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono foto-esquina" aria-hidden="true"><span><Icono nombre={f.icono || 'escudo'} tam={72} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="banda banda--blanca">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita">
          <p class="ficha-cita-titulo">¿Lo comparamos por ti?</p>
          <p>Miramos varias compañías y te lo explicamos por escrito, sin compromiso.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda--niebla" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor ficha-franja">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda--niebla">
      <div class="contenedor ficha-franja">
        <Titular antetitulo={nombreSeccion} titulo="Otros seguros que te pueden interesar" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'escudo'} tam={24} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn" href={rutaDeSeccion(f.idSeccion)}>Ver todos los seguros</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-top: clamp(1rem, 2vw, 1.5rem); padding-bottom: 0; }
  .ficha-franja { padding-block: clamp(3rem, 6vw, 5.5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; color: var(--c-acento); }
  .migas a { color: var(--c-sobre-oscuro); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2rem); align-items: stretch; }
  .ficha-hero-texto { padding-bottom: clamp(1rem, 3vw, 3.5rem); align-self: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.4rem, 6.5vw, 5rem); overflow-wrap: anywhere; color: var(--c-sobre-oscuro); }
  .ficha-chips { margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 700; font-size: 1.3rem; color: var(--c-primario); }
  .ficha-hero .ficha-precio { color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--c-oscuro); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--c-oscuro); }
  .ficha-icono span { display: grid; place-items: center; width: 9rem; height: 9rem; border-radius: 999px; background: var(--c-acento); color: var(--c-oscuro); }
  .ficha-cuerpo { display: grid; gap: 3rem; padding-block: clamp(3rem, 6vw, 5.5rem); }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-family: var(--fuente-titulos); font-size: 1.4rem; line-height: 1.4; color: var(--c-primario); }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.35rem; margin-bottom: 1rem; color: var(--c-primario); }
  .ficha-datos { background: var(--c-claro); border-top: 4px solid var(--c-acento); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--c-linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; background: var(--c-primario); color: var(--c-sobre-oscuro); padding: 1.75rem 1.5rem 2.5rem; border-radius: 0 0 0 3rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.6rem; font-weight: 700; line-height: 1.12; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 700; color: var(--c-acento); text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; background: var(--c-fondo); border-top: 4px solid var(--c-acento); transition: box-shadow .2s ease; }
  .ficha-otra:hover { box-shadow: 0 18px 30px -22px color-mix(in srgb, var(--c-primario) 70%, transparent); }
  .ficha-otra-icono { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 999px; background: var(--c-primario); color: var(--c-acento); }
  .ficha-otra h3 { font-size: 1.4rem; margin-top: .35rem; color: var(--c-primario); }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-primario); outline-offset: 2px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 700; color: var(--c-acento-texto); }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 8rem; }
  }
</style>
